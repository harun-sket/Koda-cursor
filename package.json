{
  "name": "koda-cursor",
  "displayName": "KODA — AI Code Editor",
  "description": "Cursor-style AI coding inside VS Code. By Harun / HYNAWEB.",
  "version": "0.4.0",
  "publisher": "hynaweb",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Other", "Education"],
  "activationEvents": [],
  "main": "./extension.js",
  "repository": { "type": "git", "url": "https://github.com/harun-sket/Koda-cursor.git" },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "koda-sidebar", "title": "KODA", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "koda-sidebar": [
        { "id": "koda.chatView", "name": "Chat", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "koda.openChat", "title": "KODA: Open Chat" },
      { "command": "koda.newChat", "title": "KODA: New Chat" },
      { "command": "koda.inlineEdit", "title": "KODA: Inline Edit" },
      { "command": "koda.explainSelection", "title": "KODA: Explain Selection" },
      { "command": "koda.clearChat", "title": "KODA: Clear Chat" },
      { "command": "koda.runAction", "title": "KODA: Run Action" }
    ],
    "keybindings": [
      { "command": "koda.inlineEdit", "key": "ctrl+alt+i", "mac": "cmd+alt+i", "when": "editorTextFocus" },
      { "command": "koda.openChat", "key": "ctrl+alt+l", "mac": "cmd+alt+l" },
      { "command": "koda.explainSelection", "key": "ctrl+alt+k", "mac": "cmd+alt+k", "when": "editorHasSelection" }
    ],
    "menus": {
      "editor/context": [
        { "command": "koda.inlineEdit", "group": "koda@1" },
        { "command": "koda.explainSelection", "when": "editorHasSelection", "group": "koda@2" }
      ]
    },
    "configuration": {
      "title": "KODA",
      "properties": {
        "koda.workerUrl": {
          "type": "string",
          "default": "https://koda-api-proxy.harun9842245.workers.dev",
          "description": "KODA Cloudflare Worker URL (no trailing slash)."
        },
        "koda.model": {
          "type": "string",
          "enum": ["auto", "smart", "fast", "code-master"],
          "enumDescriptions": [
            "Auto — uses gpt-oss-120b, falls back to gpt-oss-20b or qwen3-32b on failure",
            "Smart — always uses gpt-oss-120b, falls back to gpt-oss-20b",
            "Fast — uses gpt-oss-20b, falls back to qwen3-32b (higher free-tier rate limit)",
            "Code Master — DeepSeek R1 Distill Qwen 32B for reasoning, debugging, and code review"
          ],
          "default": "auto",
          "description": "Which model to use for chat replies."
        },
        "koda.temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6,
          "description": "Response creativity. Lower is more focused, higher is more varied."
        },
        "koda.autoApply": {
          "type": "boolean",
          "default": false,
          "description": "Auto-apply edits from chat without a diff confirmation."
        },
        "koda.webSearchByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Enable web search on every chat message."
        },
        "koda.showSources": {
          "type": "boolean",
          "default": true,
          "description": "Show the sources panel under replies when web search is active."
        },
        "koda.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting a conversation."
        },
        "koda.maxContextFiles": {
          "type": "number",
          "minimum": 1,
          "maximum": 20,
          "default": 6,
          "description": "How many open files to attach as context."
        }
      }
    }
  }
}
